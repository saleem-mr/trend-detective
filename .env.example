# ---- LLM (all optional) -------------------------------------------------
# The chat works with no keys at all: it tries the provider chain, then a
# keyless public endpoint, then a deterministic rule-based interpreter.
# The model only ever receives the computed results JSON, never raw data.
LLM_PROVIDER=tokenharbor
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

TOKENHARBOR_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ---- engine -------------------------------------------------------------
ML_ENGINE_PATH=/app/engine/trend-detect
ML_TIMEOUT_MS=60000

# ---- defaults -----------------------------------------------------------
NEXT_PUBLIC_DEFAULT_REGION_NAME=Western Sahel
NEXT_PUBLIC_DEFAULT_BBOX=12,18,-16,16

# NASA POWER needs no credentials for the variables used here.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
